# stellar:testnet only. Copy to .env and fill in; never commit .env.

# ── Seller (app.py) ──────────────────────────────────────────────
# Public key (G...) of a testnet account you own that RECEIVES the payments.
# It needs a USDC trustline. The server never needs this account's secret.
SELLER_PUBLIC_KEY=
# Free testnet facilitator key: https://channels.openzeppelin.com/testnet/gen
# (a mainnet key returns 401 on testnet)
FACILITATOR_API_KEY=
# Price of /paid/forecast in USD (USDC). Default $0.01
X402_PRICE=$0.01
# Optional overrides
# FACILITATOR_URL=https://channels.openzeppelin.com/x402/testnet
# PORT=8402

# ── Payer (pay.py) ───────────────────────────────────────────────
# Your own testnet payer secret (S...), with a USDC trustline and testnet USDC.
# The facilitator sponsors the fee, so it needs no XLM for the payment itself.
STELLAR_SECRET_KEY=
# SELLER_URL=http://127.0.0.1:8402/paid/forecast
