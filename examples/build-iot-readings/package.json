{
  "name": "nirium-build-iot-readings",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multi-sensor signed IoT readings collected into local batches with one Audit Trail receipt per batch",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "run-batches": "node --import tsx src/cli.ts run",
    "check-batch": "node --import tsx src/cli.ts check-batch",
    "receipts": "node --import tsx src/cli.ts receipts"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^14.5.0",
    "dotenv": "^17.2.3",
    "nirium": "^0.19.8",
    "nirium-cli": "^3.2.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "Apache-2.0"
}
