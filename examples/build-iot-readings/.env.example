# Your own Stellar testnet key, used only to sign batch receipts as the gateway (never commit it).
# Generate one with: npm run receipts -- --new-key   (prints a fresh testnet keypair)
IOT_GATEWAY_SECRET=
# Testnet Audit Trail node (free, no API key).
NIRIUM_API_URL=https://nirium-agent.fly.dev
NIRIUM_API_KEY=
# Where batch files, receipts and the simulated sensors' keys are kept. Never leaves this machine.
IOT_DIR=.iot
# Must start with wave11-
IOT_TAG=wave11-iot-readings
# Minutes of sensor time covered by one batch (used by `run` and `watch`).
IOT_INTERVAL_MIN=5
