# Your own Stellar testnet secret key for the IoT gateway (never commit it).
# Generate a fresh testnet keypair with: npm run receipts -- --new-key
GATEWAY_SECRET_KEY=

# Testnet Audit Trail node (free, no API key required)
NIRIUM_API_URL=https://nirium-agent.fly.dev
NIRIUM_API_KEY=

# Local directory for stored batch files and receipts (never leaves this machine)
BATCH_DIR=.batches

# Must start with wave11-
AUDIT_TAG=wave11-iot-readings

# Batch collection interval in seconds for continuous/demo runs (default: 5s for quick demo; set 300 for 5 min)
BATCH_INTERVAL_SECONDS=5
