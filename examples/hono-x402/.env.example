PORT=3402
X402_PRICE=0.02
X402_NETWORK=stellar:testnet

# Seller: the PUBLIC Stellar address that receives payments (G...).
# `npm run testnet:setup` generates it for you and writes it here.
X402_SELLER_ADDRESS=

# Free per-network key from OpenZeppelin Channels. x402Serve() requires one even on testnet.
# Get one at https://channels.openzeppelin.com/testnet/gen
FACILITATOR_API_KEY=

# Optional: use your own facilitator instead of OpenZeppelin Channels.
# X402_FACILITATOR_URL=https://facilitator.example.com

# ---- Only used by `npm run testnet:setup` and `npm run testnet:proof` ----
# Throwaway TESTNET secret keys (S...). `npm run testnet:setup` generates both if empty,
# funds them with Friendbot, and opens USDC trustlines. Never use a key someone gave you,
# never a mainnet key, and never commit .env.
SELLER_SECRET=
BUYER_SECRET=
