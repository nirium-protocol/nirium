# Stellar testnet secret key of the PAYER (funded via Friendbot, with a USDC trustline and testnet USDC)
# Generate: https://laboratory.stellar.org/#account-creator?network=test
STELLAR_SECRET_KEY=

# OpenAI API key for the live crew run (CrewAI uses gpt-4o-mini by default)
OPENAI_API_KEY=
# Optional: another model name supported by CrewAI's LLM()
# CREWAI_MODEL=gpt-4o-mini

# x402 server settings (server/, your own x402Serve route)
# Testnet public key you own that RECEIVES the payments (not the payer's key)
SELLER_PUBLIC_KEY=
# Free testnet facilitator key: https://channels.openzeppelin.com/testnet/gen
FACILITATOR_API_KEY=
X402_SERVER_PORT=3402
X402_PRICE=0.02
