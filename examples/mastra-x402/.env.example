# Buyer: your own stellar:testnet key (Friendbot is fine). Never commit it.
STELLAR_SECRET_KEY=S...

# Per-payment cap for the tool, in USDC.
NIRIUM_X402_CAP=$0.05

# The seller you run with `npm run server` (your own payTo, not a Nirium address).
NIRIUM_X402_TARGET=http://127.0.0.1:3404/premium/signals
NIRIUM_X402_BASE=http://127.0.0.1:3404

# Seller: your own Stellar testnet address that receives the USDC.
NIRIUM_X402_PAY_TO=G...

# Free, per-network, from channels.openzeppelin.com/testnet/gen
NIRIUM_X402_FACILITATOR_API_KEY=

# LLM for `npm run agent` (optional: `npm start` runs the tool with no LLM).
MASTRA_MODEL=openai/gpt-5-mini
