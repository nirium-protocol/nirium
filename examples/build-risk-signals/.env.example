# Nirium Risk Signals Example (Stellar Testnet Only)
# Monitor agent is strictly read-only and NEVER reads OWNER_SECRET_KEY.
NIRIUM_BASE_URL=https://nirium-agent.fly.dev
VAULT_ID=
CONCENTRATION_THRESHOLD_PERCENT=75.0
MIN_IDLE_BUFFER_PERCENT=25.0
POLL_INTERVAL_SECONDS=10
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Vault Owner secret seed (S...) — ONLY read by owner commands (owner-move / demo setup).
# Never passed to the monitor agent and never committed.
# OWNER_SECRET_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
