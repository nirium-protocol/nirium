# The courier's own Stellar testnet key, used only to sign delivery receipts (never commit it).
# Generate one with: npm run receipts -- --new-key
COURIER_SECRET=
# Testnet Audit Trail node (free, no API key).
NIRIUM_API_URL=https://nirium-agent.fly.dev
NIRIUM_API_KEY=
# Where photos and delivery details are kept. Never leaves the courier's / shop's machines.
DELIVERY_DIR=.deliveries
# Must start with wave11-
DELIVERY_TAG=wave11-proof-of-delivery
