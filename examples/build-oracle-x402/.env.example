# Your OWN stellar:testnet keys. Never use a key someone gave you; never commit .env.
# Generate them with:  npm run keys   (prints public keys; secrets go only into this file)
ORACLE_SECRET=
BUYER_SECRET=
# Filled in after deploying the contract (see README)
ORACLE_CONTRACT_ID=
# Free testnet key: https://channels.openzeppelin.com/testnet/gen
FACILITATOR_API_KEY=
