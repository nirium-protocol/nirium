{
  "name": "nirium-build-oracle-x402-example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Autonomous oracle: writes a public data point to a Soroban contract and sells the latest value over x402 on stellar:testnet.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "keys": "node --import tsx src/cli.ts keys",
    "oracle:write": "node --import tsx src/cli.ts write",
    "oracle:serve": "node --import tsx src/cli.ts serve",
    "buyer": "node --import tsx src/cli.ts buy",
    "negative-test": "node --import tsx src/cli.ts negative-test"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^15.1.0",
    "@x402/core": "^2.24.0",
    "@x402/express": "^2.24.0",
    "@x402/extensions": "^2.24.0",
    "@x402/fetch": "^2.24.0",
    "@x402/stellar": "^2.24.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "nirium": "^0.19.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.30",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "Apache-2.0"
}
