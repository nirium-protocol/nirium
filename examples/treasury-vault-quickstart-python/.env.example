# Copy this file to .env and fill in your own testnet secret.
# NEVER commit .env or share your S... key.

# Your Stellar testnet secret key (starts with S). Get one from:
# https://laboratory.stellar.org/#account-creator?network=testnet
# Or fund an existing account via Friendbot: https://friendbot.stellar.org
STELLAR_SECRET_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Optional: your personal Nirium API key (JWT). If unset, a public demo token is used.
# NIRIUM_API_KEY=eyJ...

# Optional: override the Nirium agent base URL (testnet)
# NIRIUM_BASE_URL=https://nirium-agent.fly.dev

# Optional: vault asset from treasury info (usdc or cetes)
# VAULT_ASSET=usdc

# Optional: deposit amount in stroops (7 decimals for USDC)
# DEPOSIT_AMOUNT_STROOPS=10000000

# Optional: invest the deposit immediately (true/false)
# INVEST=false

# Optional: reuse an existing vault ID (skips deploy)
# VAULT_ID=

# Optional: vault manager (defaults to caller/your G-address)
# VAULT_MANAGER=

# Optional: vault name and symbol
# VAULT_NAME=Quickstart ABCD
# VAULT_SYMBOL=QSABC

# Optional: network passphrase (must be testnet)
# NETWORK_PASSPHRASE=Test SDF Network ; September 2015