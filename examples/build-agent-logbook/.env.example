# Your own Stellar testnet key, used only to sign audit receipts (never commit it).
# Generate one with: npm run receipts -- --new-key   (prints a fresh testnet keypair)
LOGBOOK_AGENT_SECRET=
# Testnet Audit Trail node (free, no API key).
NIRIUM_API_URL=https://nirium-agent.fly.dev
NIRIUM_API_KEY=
# Where full logbook entries are kept. Never leaves this machine.
LOGBOOK_DIR=.logbook
# Must start with wave11-
LOGBOOK_TAG=wave11-agent-logbook
