# Stellar Testnet Secret Key for signing audit receipts (starts with S)
# Generate one with: node -e "const { Keypair } = require('@stellar/stellar-sdk'); console.log(Keypair.random().secret())"
STELLAR_SECRET_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Testnet Audit Node URL (public testnet, free, no API key required)
NIRIUM_NODE_URL=https://nirium-agent.fly.dev
