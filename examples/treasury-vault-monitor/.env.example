# Nirium Treasury Vault Monitor Configuration
# Strictly READ-ONLY: NO private keys (STELLAR_SECRET_KEY) are used or accepted.

# Fly.io testnet agent endpoint
NIRIUM_BASE_URL=https://nirium-agent.fly.dev

# Testnet vault contract address (C...) to monitor
# If left empty, the monitor auto-selects the first available vault from getTreasuryVaults()
VAULT_ID=CDQHTFRWCCJTPWYJABGGKOHKBVPMXTQOKQQBWJF3VQ2LWS63KYC2V7MY

# Polling frequency in minutes (default: 5)
POLL_INTERVAL_MINUTES=5

# Balance movement alert threshold in percent (default: 5.0)
BALANCE_THRESHOLD_PERCENT=5.0

# Strategy allocation drift alert threshold in percent (default: 5.0)
ALLOCATION_THRESHOLD_PERCENT=5.0

# Optional Webhook URL to dispatch JSON alerts
# ALERT_WEBHOOK_URL=https://webhook.site/your-unique-uuid
