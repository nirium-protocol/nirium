# Multi-party Stellar testnet keys for logistics handoffs (never commit secrets).
# Generate fresh testnet keys with: npm run receipts -- --new-key
ORIGIN_SECRET=
CARRIER_SECRET=
DISTRIBUTOR_SECRET=
DESTINATION_SECRET=

# Nirium Audit Trail node (public testnet endpoint)
NIRIUM_API_URL=https://nirium-agent.fly.dev
NIRIUM_API_KEY=

# Local checkpoint store directory (stays off-chain)
CHECKPOINT_DIR=.checkpoints

# Audit Trail tag (must start with wave11-)
LOGISTICS_TAG=wave11-logistics-checkpoints
