{
  "name": "nirium-build-logistics-checkpoints",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multi-party logistics checkpoints with signed receipts at each handoff anchored to Nirium Audit Trail on Stellar testnet",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "demo": "node --import tsx src/cli.ts demo",
    "check-chain": "node --import tsx src/cli.ts check-chain",
    "record-handoff": "node --import tsx src/cli.ts record-handoff",
    "receipts": "node --import tsx src/cli.ts receipts",
    "testnet-evidence": "node --import tsx src/testnet-evidence.ts"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^14.5.0",
    "dotenv": "^17.2.3",
    "nirium": "^0.19.8",
    "nirium-cli": "^3.2.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "Apache-2.0"
}
