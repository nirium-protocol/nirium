{
  "name": "nirium-build-disclosure-commitment-example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "commit": "node --import tsx src/cli.ts commit",
    "reveal": "node --import tsx src/cli.ts reveal",
    "commitments": "node --import tsx src/cli.ts list"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^14.5.0",
    "dotenv": "^17.2.3",
    "nirium": "^0.19.6",
    "nirium-cli": "^3.2.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.30",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "Apache-2.0"
}
