# Your own Stellar testnet payer key (S...), funded via Friendbot and holding
# testnet USDC. Never commit it and never use a key someone gave you.
STELLAR_SECRET_KEY=

# Optional: a real model call. Without it, `npm run demo` uses the scripted
# model in src/scripted-model.ts, so the tool loop runs without a model API.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# The x402 endpoint the tool pays. Defaults match src/server.ts.
PAID_ENDPOINT=http://localhost:3402/paid/market-summary
EXPENSIVE_ENDPOINT=http://localhost:3402/paid/full-report
MAX_AMOUNT_PER_PAYMENT=$1

# Seller (server/) settings: a second testnet account you own that RECEIVES
# the payments, plus a free testnet facilitator key.
SELLER_PUBLIC_KEY=
FACILITATOR_API_KEY=
X402_SERVER_PORT=3402
X402_PRICE=0.02
