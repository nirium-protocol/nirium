# Copiar a .env (gitignored) y rellenar SOLO con claves de STELLAR TESTNET.
# Nunca compartas ni comitees una clave S... . Este ejemplo no lee mainnet.

# Owner / Manager del vault: puede cambiar el RebalanceManager y retirar SUS acciones.
OWNER_SECRET_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Agente con rol de RebalanceManager: SOLO puede proponer/firmar rebalances.
MANAGER_SECRET_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Vault DeFindex desplegado en Stellar testnet.
VAULT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Umbrales de la propuesta (los fija el humano; no son defaults de Nirium).
ENTER_AT=1.0
EXIT_AT=2.0
MIN_IDLE_STROOPS=

# Opcional. Si falta, se pide un token público demo con la G-address del owner.
# NIRIUM_API_KEY=
# NIRIUM_BASE_URL=https://nirium-agent.fly.dev

# Obligatorio que sea exactamente la passphrase de testnet.
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Solo para --negative-testnet --i-understand-testnet-only.
WITHDRAW_SHARES_STROOPS=1
