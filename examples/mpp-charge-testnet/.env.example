# Seller public key (G...) that RECEIVES the payment. Not a secret.
SELLER_PUBLIC_KEY=

# Payer secret key (S...) used by initMpp(). A testnet account you own,
# funded with XLM (Friendbot) and testnet USDC. Never commit this file
# and never reuse a key someone gave you.
PAYER_SECRET_KEY=

# Optional. Defaults match src/server.ts and src/demo.ts.
# PORT=3403
# CHARGE_AMOUNT=0.01
