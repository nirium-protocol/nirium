    "server": "node --import tsx src/server.ts"
  },
  "dependencies": {
    "@stellar/mpp": "0.7.1",
    "@stellar/stellar-sdk": "17.4.0",
    "dotenv": "17.4.2",
    "mppx": "0.6.31",
    "nirium": "0.20.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
