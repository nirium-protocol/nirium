{
  "name": "nirium-mpp-charge-testnet-example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Start an upstream @stellar/mpp Charge server on Stellar testnet and pay one request with nirium initMpp().",
  "scripts": {
    "typecheck": "tsc --noEmit",
