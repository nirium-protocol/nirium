# Stellar public key (G...) that receives payment. Public — never a secret.
X402_SELLER_ADDRESS=

# Free testnet facilitator key: GET https://channels.openzeppelin.com/testnet/gen
# (open it in a browser, or `curl`; a POST here returns 401)
FACILITATOR_API_KEY=

X402_FACILITATOR_URL=https://channels.openzeppelin.com/x402/testnet
X402_NETWORK=stellar:testnet
X402_PRICE=$0.02
PORT=3402

# Only needed for `npm run wallet-bridge-smoke` — a throwaway Stellar
# testnet secret key that will actually pay the seller above. Fund it with
# testnet XLM (friendbot) and testnet USDC (https://faucet.circle.com/,
# network: Stellar) before running the smoke script. Never a mainnet key.
PLAYER_SECRET_KEY=
