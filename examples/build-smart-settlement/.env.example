# Your own Stellar testnet payer key (S...), funded via Friendbot and holding
# testnet USDC. Never commit it and never use a key someone gave you.
STELLAR_SECRET_KEY=

# Seller (G...) that RECEIVES the payments. A second testnet account you own.
# It needs a USDC trustline. Do not put a secret here.
SELLER_PUBLIC_KEY=

# Free testnet facilitator key from https://channels.openzeppelin.com/testnet/gen
FACILITATOR_API_KEY=

# Optional facilitator override.
# FACILITATOR_URL=https://channels.openzeppelin.com/x402/testnet

# Optional server/demo settings. Defaults match src/server.ts and src/demo.ts.
X402_SERVER_PORT=3402
X402_PRICE=0.02
